# Regression tests for https://github.com/tursodatabase/turso/issues/10967
# Appending to a top-level array with $[#] or with an index one past the end
# must grow the array's size header by the size of the new element.

@database :memory:

test jsonb-insert-append-to-root-array {
    SELECT hex(jsonb_insert('[]', '$[#]', 1)),
           hex(jsonb_insert('[1]', '$[#]', 2));
}
expect {
    2B1331|4B13311332
}

test json-insert-append-to-root-array-twice {
    SELECT json_insert('[]', '$[#]', 1, '$[#]', 2),
           json_insert('[1]', '$[#]', 2, '$[#]', 3);
}
expect {
    [1,2]|[1,2,3]
}

test json-insert-root-array-index-past-end {
    SELECT json_insert('[]', '$[0]', 1, '$[1]', 2),
           json(jsonb_insert(jsonb('[1,2,3,4,5]'), '$[5]', 6));
}
expect {
    [1,2]|[1,2,3,4,5,6]
}

test json-set-append-to-root-array {
    SELECT hex(jsonb_set('[]', '$[#]', 1)),
           json_set('[]', '$[#]', 1, '$[#]', 2);
}
expect {
    2B1331|[1,2]
}

test json-insert-root-array-header-grows {
    SELECT hex(jsonb_insert('[1,2,3,4,5]', '$[#]', 6)),
           json_insert('[1,2,3,4,5]', '$[#]', 6, '$[#]', 7);
}
expect {
    CB0C133113321333133413351336|[1,2,3,4,5,6,7]
}

test json-insert-root-array-then-nested-array {
    SELECT json_insert('[[]]', '$[#]', 1, '$[0][#]', 2);
}
expect {
    [[2],1]
}
